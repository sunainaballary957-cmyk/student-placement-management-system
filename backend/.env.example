# Copy to .env and adjust for your deployment.
# main.py currently uses hardcoded defaults for local/demo use;
# wiring these in via os.environ is a one-line change in auth.py/database.py.

DATABASE_URL=sqlite:///./placement.db
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
